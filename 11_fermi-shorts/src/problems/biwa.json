  "writingPlan": [
    {"text": "琵琶湖の水は何リットル？", "start": 105, "duration": 62, "top": 45, "left": 70, "size": 58, "emphasis": true, "width": 700},
    {"text": "水量 ＝ 面積 × 平均水深", "start": 180, "duration": 60, "top": 180, "left": 70, "size": 46, "width": 610},
    {"text": "面積 ≒ 670 km²", "start": 255, "duration": 48, "top": 330, "left": 70, "size": 50, "width": 480},
    {"text": "平均水深 ≒ 40 m と仮定", "start": 315, "duration": 58, "top": 450, "left": 70, "size": 44, "width": 650},
    {"text": "670 × 10⁶ × 40", "start": 390, "duration": 55, "top": 610, "left": 70, "size": 52, "width": 510},
    {"text": "≒ 2.7 × 10¹⁰ m³", "start": 460, "duration": 58, "top": 725, "left": 70, "size": 52, "width": 580},
    {"text": "1 m³ = 1000 L", "start": 535, "duration": 48, "top": 880, "left": 70, "size": 45, "width": 430},
    {"text": "≒ 2.7 × 10¹³ L", "start": 600, "duration": 55, "top": 995, "left": 70, "size": 55, "emphasis": true, "width": 570},
    {"text": "約27兆リットル！", "start": 670, "duration": 62, "top": 1110, "left": 70, "size": 64, "emphasis": true, "width": 570}
  ],
  "captions": [
    {"text": "フェルミ推定。琵琶湖の水は何リットル？", "start": 0, "end": 105},
    {"text": "水量は、面積かける平均水深でざっくり見積もれます。", "start": 105, "end": 250},
    {"text": "面積670平方キロ、平均水深40メートルと仮定。", "start": 250, "end": 390},
    {"text": "計算すると約2.7×10の10乗立方メートル。", "start": 390, "end": 535},
    {"text": "1立方メートルは1000リットルなので…", "start": 535, "end": 670},
    {"text": "約2.7×10の13乗、つまり約27兆リットル！", "start": 670, "end": 900}
  ],
